Options -Indexes -MultiViews
DirectoryIndex index.php
<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set X-Frame-Options "SAMEORIGIN"
 Header always set Referrer-Policy "strict-origin-when-cross-origin"
 <FilesMatch "\.(css|js|webp|svg)$">
  Header set Cache-Control "public, max-age=604800"
 </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
 AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml
</IfModule>
<FilesMatch "(?i)(^\.|^config\.|\.(sql|md|log|ini|zip|json|py|docx)$)">
 Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^(?:app|views|data|database|bin|tests|docs)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]
